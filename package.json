{
  "name": "attendance-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Attendance Management Desktop Application - Local-first with SQLite",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run electron:dev",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run db:generate -w @attendance/backend",
    "db:migrate": "npm run db:migrate -w @attendance/backend",
    "db:studio": "npm run db:studio -w @attendance/backend",
    "postinstall": "npm run db:generate -w @attendance/backend",
    "predev": "npm run build -w @attendance/config && npm run build -w @attendance/shared && npm run build -w @attendance/backend",
    "electron:dev": "npm run dev -w @attendance/desktop",
    "electron:build": "npm run build -w @attendance/desktop"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
